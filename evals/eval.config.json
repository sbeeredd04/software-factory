        "golden"
      ]
    },
    "epic": {
      "scope": "epic_cases_plus_regression"
    },
    "premerge": {
      "scope": "all_cases"
    },
    "canary": {
      "scope": "smoke_plus_ops"
    }
  },
  "routing": {
    "retry_cap_per_case": 3,
    "escalate_after_cap": [
      "maintainer-checkpoint"
    ],
    "quarantine_on_flake": true,
    "quarantine_must_resolve_by": "epic_close",
    "override": {
      "allowed": true,
      "record": [
        "who",
        "when",
        "reason"
      ]
    }
  },
  "receipts": {
    "per_case_files": true,
    "artifacts_on_failure": [
      "output_tail",
      "diff"
    ],
    "manifest_citation": {
      "fields": [
        "run_id",
        "verdict",
        "case_results",
        "self_sha256"
      ],
      "required_for": [
        "story_done",
        "merge"
      ]
    }
  },
  "judge_policy": {
    "last_resort": true,
    "binary_assertions_only": true,
