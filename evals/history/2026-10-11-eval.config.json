  "modes": {
    "quick": {
      "scope": "story_cases_plus_smoke",
      "max_duration_sec": 300,
      "allow_grades": [
        "state",
        "command",
        "http",
        "golden"
      ]
    },
    "epic": {
      "scope": "epic_cases_plus_regression"
    },
    "premerge": {
      "scope": "all_cases"
    },
    "canary": {
      "scope": "smoke_plus_ops"
    }
  },
  "routing": {
    "retry_cap_per_case": 3,
    "escalate_after_cap": [
      "maintainer-checkpoint"
    ],
    "quarantine_on_flake": true,
    "quarantine_must_resolve_by": "epic_close",
    "override": {
      "allowed": true,
      "record": [
        "who",
        "when",
        "reason"
      ]
    }
  },
  "receipts": {
    "per_case_files": true,
    "artifacts_on_failure": [
      "output_tail",
      "diff"
    ],
    "manifest_citation": {
      "fields": [
        "run_id",
        "verdict",
        "case_results",
        "self_sha256"
      ],
      "required_for": [
        "story_done",
        "merge"
      ]
    }
  },
  "judge_policy": {
    "last_resort": true,
    "binary_assertions_only": true,
    "one_dimension_per_call": true,
    "never_sole_gate_below_tier": 2,
    "note": "the pack's own suite is fully deterministic; no judge cases"
  },
  "signoff": {
    "status": "approved",
    "approved_by": "the repository maintainer (@sbeeredd04)",
    "approved_at": "2026-10-11",
    "plan_sha256": "35998a2ea381efe8c0242f5fe78b7b5451527bad395b8167fb869b5bd6c49992",
    "digest_rule": "sha256 over the plan serialized as UTF-8 JSON with sorted keys and compact separators, the signoff object excluded"
  }
}
