{
  "version": 1,
  "inputs": [
    "assets/templates/assets.css",
    "assets/templates/hero.html",
    "assets/templates/hosts.html",
    "assets/templates/launch-landscape.html",
    "assets/templates/launch-portrait.html",
    "assets/templates/loop.html",
    "assets/templates/ready.js",
    "assets/templates/social-preview.html",
    "assets/templates/team.html",
    "assets/toolchain.json",
    "assets/tools/capture.py",
    "scripts/render_assets.py",
    "site/fonts/bricolage/BricolageGrotesque96pt-Bold.woff2",
    "site/fonts/inter/Inter-Regular.woff2",
    "site/fonts/inter/Inter-SemiBold.woff2",
    "site/fonts/jetbrains-mono/JetBrainsMono-Regular.woff2",
