      "copies": [],
      "use": "Manual repository social-preview upload."
    },
    {
      "id": "hero",
      "template": "assets/templates/hero.html",
      "output": "assets/hero.png",
      "width": 1600,
      "height": 900,
      "copies": [],
      "use": "README overview."
    },
    {
      "id": "loop",
      "template": "assets/templates/loop.html",
      "output": "assets/loop.png",
      "width": 1200,
      "height": 800,
      "copies": [
        "site/img/loop.png"
      ],
      "use": "Showcase delivery-loop card and shareable explainer."
    },
    {
      "id": "team",
      "template": "assets/templates/team.html",
      "output": "assets/team.png",
      "width": 1200,
      "height": 800,
      "copies": [
        "site/img/team.png"
      ],
      "use": "Showcase role-team card and shareable explainer."
    },
    {
      "id": "hosts",
      "template": "assets/templates/hosts.html",
      "output": "assets/hosts.png",
      "width": 1200,
      "height": 800,
      "copies": [
        "site/img/hosts.png"
      ],
      "use": "Showcase installation-route card and shareable explainer."
    },
    {
      "id": "launch-landscape",
      "template": "assets/templates/launch-landscape.html",
      "output": "assets/launch-landscape.png",
      "width": 1200,
      "height": 675,
      "copies": [],
      "use": "Landscape launch-post attachment."
    },
    {
      "id": "launch-portrait",
      "template": "assets/templates/launch-portrait.html",
      "output": "assets/launch-portrait.png",
      "width": 1080,
      "height": 1350,
      "copies": [],
      "use": "Portrait launch-post attachment."
    }
  ]
