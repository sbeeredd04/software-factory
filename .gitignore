# Python
__pycache__/
*.py[cod]

# Virtual environments (never required, but never committed either)
.venv/
venv/

# Node (dev-tooling caches only; the pack ships no npm manifest)
node_modules/

# OS
.DS_Store

# Secrets and local environment files
.env
.env.*

# Generated release output (built at release time, never committed)
dist/

# Local factory runtime state (the pack is dogfooded into this repository;
# only the volatile siblings are ignored, never .software-factory/context/)
.software-factory/runtime/
.software-factory/backups/
.software-factory/runs/
.software-factory/active.json
.software-factory/state.lock
.software-factory/board.lock
.software-factory/installation.json
.software-factory/.install.lock
