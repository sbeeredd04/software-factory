{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.example/schemas/overlay.schema.json",
  "title": "Software Factory reviewed overlay manifest",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "base_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "append",
        "replace"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "risk": {
      "enum": [
        "routine",
        "material"
      ]
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verdict": {
          "const": "approved"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "by",
        "subject_sha256",
        "verdict",
        "artifact"
      ],
      "additionalProperties": false
    },
    "regression": {
      "type": "object",
      "properties": {
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result": {
          "const": "pass"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "subject_sha256",
        "result",
        "artifact"
      ],
      "additionalProperties": false
    },
    "canary": {
      "type": "object",
      "properties": {
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result": {
          "const": "pass"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "subject_sha256",
        "result",
        "artifact"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "standing-go",
            "human"
          ]
        },
        "decision": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "by",
        "subject_sha256",
        "kind",
        "decision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "target",
    "base_sha256",
    "mode",
    "payload",
    "evidence",
    "author",
    "risk",
    "subject_sha256",
    "review",
    "regression",
    "canary",
    "approval"
  ],
  "additionalProperties": false
}
