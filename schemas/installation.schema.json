{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sbeeredd04/software-factory/schemas/installation.schema.json",
  "title": "Software Factory installation manifest",
  "description": "The ownership manifest written last by every successful install transaction. Lists every factory-owned path with its installed content hash so later installs stay byte-level no-ops and uninstall removes only unchanged files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "install_id",
    "installed_at",
    "pack",
    "hosts",
    "profile",
    "files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "install_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "installed_at": {
      "type": "string",
      "format": "date-time"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "software-factory"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["claude-code", "cursor", "codex"]
      }
    },
    "profile": {
      "enum": ["full", "skills-only"]
    },
    "bmad": {
      "type": "object",
      "additionalProperties": false,
      "description": "Observed third-party provenance only; never factory ownership or permission to uninstall BMad.",
      "required": ["package", "requested_version", "tools", "status", "reason", "runtime_versions", "version", "modules", "ides", "manifest", "manifest_sha256"],
      "properties": {
        "package": {"const": "bmad-method@6.12.0"},
        "requested_version": {"const": "6.12.0"},
        "tools": {"type": "array", "items": {"enum": ["claude-code", "cursor", "codex"]}},
        "status": {"enum": ["installed", "existing", "degraded", "failed"]},
        "reason": {"type": "string"},
        "runtime_versions": {
          "type": "object", "additionalProperties": false,
          "properties": {"node": {"type": "string"}, "npm": {"type": "string"}}
        },
        "version": {"type": ["string", "null"]},
        "modules": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string"}, "version": {"type": ["string", "null"]},
              "source": {"type": ["string", "null"]}, "channel": {"type": ["string", "null"]},
              "sha": {"type": ["string", "null"]}
            }
          }
        },
        "ides": {"type": "array", "items": {"type": "string"}},
        "manifest": {"enum": ["_bmad/_config/manifest.yaml", null]},
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "action", "host", "backup"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative path, posix separators. Never under .software-factory/context/."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "action": {
            "enum": ["write", "merge", "block", "gitignore"]
          },
          "host": {
            "type": ["string", "null"],
            "enum": ["claude-code", "cursor", "codex", null]
          },
          "backup": {
            "type": ["string", "null"],
            "description": "Project-relative backup path under .software-factory/backups/ when this transaction overwrote existing bytes."
          },
          "restore": {
            "description": "Original user content restoration basis, preserved across updates. Null proves the destination was created; absence means legacy provenance is unverified.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
